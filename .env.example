# --- Deck -------------------------------------------------------------------
DECK_ID=1vgXhQgd6zspwH_iBpmeq_x4hsTTxLH9eXQR4KM4698A

# --- Auth: set ONE of these --------------------------------------------------
# Preferred: service account JSON with Viewer access to the deck.
# Paste the raw JSON on one line, or base64-encode it (base64 -w0 key.json).
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative: API key restricted to the Google Slides API (deck must be "Anyone with the link can view").
GOOGLE_API_KEY=

# --- On-demand refresh -------------------------------------------------------
# At least 16 characters. Used by /api/revalidate and the Apps Script trigger.
REVALIDATE_SECRET=

# --- Optional -----------------------------------------------------------------
# fixture = render fixtures/deck.slides.json without calling Google (local preview).
DECK_SOURCE=
# Where the snapshot + images are cached. Default .cache (or /tmp/deck-cache on Vercel).
DECK_CACHE_DIR=
# shader (default, 0 KB) | video (uses public/loop/loop.webm + loop.mp4 + poster.jpg)
NEXT_PUBLIC_BACKGROUND=
